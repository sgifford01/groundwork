{
  "name": "groundwork",
  "private": true,
  "version": "0.1.0",
  "description": "A local practice app for real estate development: Excel and pro forma modeling at its core, plus leases, plan reading, entitlements, market analysis, acquisitions, debt, asset management and construction.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "tsc --noEmit && vitest run",
    "category-status": "node scripts/run.mjs category-status",
    "sync-specs": "node scripts/run.mjs sync-specs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "hyperformula": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
